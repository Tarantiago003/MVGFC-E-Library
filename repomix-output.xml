        });

        // Generate notice preview
        noticeForm.addEventListener('submit', function(e) {
            e.preventDefault();

            const date = document.getElementById('noticeDate').value;
            const recipient = document.getElementById('recipientName').value;
            const department = document.getElementById('department').value;

            const formattedDate = new Date(date).toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
            });

            // Clear previous overlays
            overlayContainer.innerHTML = '';

            // Add DATE overlay (after "DATE:" label)
            addOverlay(formattedDate, '18%', '15.15%', '16px');

            // Add TO overlay (after "TO:" label)
            addOverlay(recipient, '15.5%', '16.9%', '16px');

            // Add COLLEGE/DEPT overlay (after "COLLEGE/DEPT.:" label)
            addOverlay(department, '28.3%', '18.65%', '16px');

            // Add book entries
            const bookAuthors = document.querySelectorAll('.book-author');
            const bookTitles = document.querySelectorAll('.book-title');
            const bookAccs = document.querySelectorAll('.book-acc');
            const bookDues = document.querySelectorAll('.book-due');

            const bookStartY = 30;
            const rowHeight = 1.7;

            for (let i = 0; i < 5; i++) {
                if (i < bookAuthors.length && bookAuthors[i].value) {
                    // Author
                    addOverlay(bookAuthors[i].value, '22%', `${bookStartY + (i * rowHeight)}%`, '10px');
                    // Title
                    addOverlay(bookTitles[i].value, '44%', `${bookStartY + (i * rowHeight)}%`, '10px');
                    // Acc No
                    addOverlay(bookAccs[i].value, '65%', `${bookStartY + (i * rowHeight)}%`, '10px');
                    // Due Date
                    if (bookDues[i].value) {
                        const dueDate = new Date(bookDues[i].value).toLocaleDateString('en-US');
                        addOverlay(dueDate, '78%', `${bookStartY + (i * rowHeight)}%`, '10px');
                    }
                }
            }

            // Add checkboxes (✓ symbol)
            const checkStartY = 40.2;
            const checkGap = 2;
            
            if (document.getElementById('reasonOverdue').checked) {
                addOverlay('✓', '26.5%', `${checkStartY}%`, '14px', 'bold');
            }
            if (document.getElementById('reasonReserved').checked) {
                addOverlay('✓', '26.5%', `${checkStartY + checkGap}%`, '14px', 'bold');
            }
            if (document.getElementById('reasonNeeded').checked) {
                addOverlay('✓', '26.5%', `${checkStartY + (checkGap * 2)}%`, '14px', 'bold');
            }
            if (document.getElementById('reasonOther').checked) {
                addOverlay('✓', '26.5%', `${checkStartY + (checkGap * 3)}%`, '14px', 'bold');
                const otherText = document.getElementById('otherReason').value;
                if (otherText) {
                    addOverlay(otherText, '50%', `${checkStartY + (checkGap * 3)}%`, '16px');
                }
            }

            // Show preview
            previewSection.style.display = 'block';
            setTimeout(() => {
                previewSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
        });

        function addOverlay(text, left, top, fontSize, fontWeight = 'normal') {
            const overlay = document.createElement('div');
            overlay.className = 'overlay-text';
            overlay.textContent = text;
            overlay.style.left = left;
            overlay.style.top = top;
            overlay.style.fontSize = fontSize;
            overlay.style.fontWeight = fontWeight;
            overlayContainer.appendChild(overlay);
        }

        // Download as PDF
        downloadBtn.addEventListener('click', async function() {
            const { jsPDF } = window.jspdf;
            const pdf = new jsPDF({
                orientation: 'portrait',
                unit: 'mm',
                format: 'a4'
            });

            // Ensure background is loaded
            if (!backgroundImageData) {
                await loadBackgroundImage();
            }

            // Add background image
            if (backgroundImageData) {
                pdf.addImage(backgroundImageData, 'PNG', 0, 0, 210, 297);
            }

            const date = document.getElementById('noticeDate').value;
            const recipient = document.getElementById('recipientName').value;
            const department = document.getElementById('department').value;

            const formattedDate = new Date(date).toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
            });

            pdf.setFont(undefined, 'bold');
            pdf.setFontSize(11);

            // DATE (18%, 15.15%)
            pdf.text(formattedDate, 37.8, 49);

            // TO (15.5%, 16.9%)
            pdf.text(recipient, 32.5, 54);

            // DEPARTMENT (28.3%, 18.65%)
            pdf.text(department, 59.5, 59);

            // Books
            const bookAuthors = document.querySelectorAll('.book-author');
            const bookTitles = document.querySelectorAll('.book-title');
            const bookAccs = document.querySelectorAll('.book-acc');
            const bookDues = document.querySelectorAll('.book-due');

            pdf.setFontSize(10);

            // bookStartY = 30%
            let yPos = 92;

            // rowHeight = 1.7%
            const rowGap = 5.05;

            for (let i = 0; i < 5; i++) {
                if (i < bookAuthors.length && bookAuthors[i].value) {
                    // Author (22%)
                    pdf.text(bookAuthors[i].value, 36, yPos);

                    // Title (44%)
                    pdf.text(bookTitles[i].value, 72, yPos);

                    // Acc No (65%)
                    pdf.text(bookAccs[i].value, 133, yPos);

                    // Due Date (78%)
                    if (bookDues[i].value) {
                        const dueDate = new Date(bookDues[i].value).toLocaleDateString('en-US');
                        pdf.text(dueDate, 158, yPos);
                    }
                }
                yPos += rowGap;
            }

            // Checkboxes
            pdf.setFontSize(14);
            pdf.setFont(undefined, 'bold');

            // checkStartY = 40.2%
            yPos = 125;

            // checkGap = 2%
            const checkGap = 5.94;

            // X = 26.5%
            const checkX = 56.5;

            if (document.getElementById('reasonOverdue').checked) {
                pdf.text('✓', checkX, yPos);
            }
            yPos += checkGap;

            if (document.getElementById('reasonReserved').checked) {
                pdf.text('✓', checkX, yPos);
            }
            yPos += checkGap;

            if (document.getElementById('reasonNeeded').checked) {
                pdf.text('✓', checkX, yPos);
            }
            yPos += checkGap;

            if (document.getElementById('reasonOther').checked) {
                pdf.text('✓', checkX, yPos);

                const otherText = document.getElementById('otherReason').value;
                if (otherText) {
                    pdf.setFontSize(11);
                    pdf.setFont(undefined, 'normal');

                    // Other text (50%)
                    pdf.text(otherText, 100, yPos - 2);
                }
            }

            // Save
            const fileName = `Library_Notice_${recipient.replace(/\s+/g, '_')}.pdf`;
            pdf.save(fileName);
        });
    </script>
</body>
</html>
</file>

<file path="styles/Home.module.css">
.page {
  --gray-rgb: 0, 0, 0;
  --gray-alpha-200: rgba(var(--gray-rgb), 0.08);
  --gray-alpha-100: rgba(var(--gray-rgb), 0.05);

  --button-primary-hover: #383838;
  --button-secondary-hover: #f2f2f2;

  display: grid;
  grid-template-rows: 20px 1fr 20px;
  align-items: center;
  justify-items: center;
  min-height: 100svh;
  padding: 80px;
  gap: 64px;
  font-family: var(--font-geist-sans);
}

@media (prefers-color-scheme: dark) {
  .page {
    --gray-rgb: 255, 255, 255;
    --gray-alpha-200: rgba(var(--gray-rgb), 0.145);
    --gray-alpha-100: rgba(var(--gray-rgb), 0.06);

    --button-primary-hover: #ccc;
    --button-secondary-hover: #1a1a1a;
  }
}

.main {
  display: flex;
  flex-direction: column;
  gap: 32px;
  grid-row-start: 2;
}

.main ol {
  font-family: var(--font-geist-mono);
  padding-left: 0;
  margin: 0;
  font-size: 14px;
  line-height: 24px;
  letter-spacing: -0.01em;
  list-style-position: inside;
}

.main li:not(:last-of-type) {
  margin-bottom: 8px;
}

.main code {
  font-family: inherit;
  background: var(--gray-alpha-100);
  padding: 2px 4px;
  border-radius: 4px;
  font-weight: 600;
}

.ctas {
  display: flex;
  gap: 16px;
}

.ctas a {
  appearance: none;
  border-radius: 128px;
  height: 48px;
  padding: 0 20px;
  border: none;
  border: 1px solid transparent;
  transition: background 0.2s, color 0.2s, border-color 0.2s;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  line-height: 20px;
  font-weight: 500;
}

a.primary {
  background: var(--foreground);
  color: var(--background);
  gap: 8px;
}

a.secondary {
  border-color: var(--gray-alpha-200);
  min-width: 180px;
}

.footer {
  grid-row-start: 3;
  display: flex;
  gap: 24px;
}

.footer a {
  display: flex;
  align-items: center;
  gap: 8px;
}

.footer img {
  flex-shrink: 0;
}

/* Enable hover only on non-touch devices */
@media (hover: hover) and (pointer: fine) {
  a.primary:hover {
    background: var(--button-primary-hover);
    border-color: transparent;
  }

  a.secondary:hover {
    background: var(--button-secondary-hover);
    border-color: transparent;
  }

  .footer a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
}

@media (max-width: 600px) {
  .page {
    padding: 32px;
    padding-bottom: 80px;
  }

  .main {
    align-items: center;
  }

  .main ol {
    text-align: center;
  }

  .ctas {
    flex-direction: column;
  }

  .ctas a {
    font-size: 14px;
    height: 40px;
    padding: 0 16px;
  }

  a.secondary {
    min-width: auto;
  }

  .footer {
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }
}

@media (prefers-color-scheme: dark) {
  .logo {
    filter: invert();
  }
}
